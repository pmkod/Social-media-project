generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationEventType {
  FOLLOW
  POST_LIKE
  COMMENT_LIKE
  POST_COMMENT
  COMMENT_REPLY
}

model Notification {
  id          String                @id @default(cuid())
  recipientId String                @map("recipient_id")
  initiatorId String                @map("initiator_id")
  eventType   NotificationEventType @map("event_type")
  targetId    String?               @map("target_id")
  groupKey    String                @map("group_key")
  isSeen      Boolean               @default(false) @map("is_seen")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([recipientId, createdAt, id])
  @@index([recipientId, isSeen])
  @@index([recipientId, eventType, groupKey, initiatorId, targetId])
  @@index([targetId])
  @@index([groupKey])
  @@map("notification")
}
