generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  pending
  rejected
  resolved
}

enum ReportTargetType {
  post
  comment
  user
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String           @map("reporter_id")
  reasonId    String           @map("reason_id")
  reasonText  String?          @map("reason_text") @db.VarChar(280)
  description String?          @db.VarChar(2000)
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  status      ReportStatus     @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  reason      ReportReason     @relation(fields: [reasonId], references: [id], onDelete: Restrict)

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("report")
}

model ReportReason {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  active      Boolean  @default(true)
  reports     Report[]

  @@index([active, name])
  @@map("report_reason")
}
