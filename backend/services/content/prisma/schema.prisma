generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  POST
  CHILLZ
}

model Post {
  id            String      @id @default(cuid())
  type          PostType    @default(POST)
  authorId      String      @map("author_id")
  text          String      @map("content")
  likesCount    Int         @default(0) @map("likes_count")
  commentsCount Int         @default(0) @map("comments_count")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  medias        PostMedia[]
  comments      Comment[]
  postLikes     PostLike[]
  bookmarks     Bookmark[]

  @@index([createdAt, id])
  @@index([type, createdAt, id])
  @@index([authorId, type, createdAt, id])
  @@map("post")
}

model PostMedia {
  id                String   @id @default(uuid())
  postId            String   @map("post_id")
  post              Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  position          Int      @default(1)
  mediaType         String   @map("media_type") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at")
  lowQualityFileId  String?  @unique @map("low_quality_file_id")
  lowQualityFile    File?    @relation("PostMediaLowQuality", fields: [lowQualityFileId], references: [id], onDelete: SetNull)
  highQualityFileId String?  @unique @map("high_quality_file_id")
  highQualityFile   File?    @relation("PostMediaHighQuality", fields: [highQualityFileId], references: [id], onDelete: SetNull)

  @@map("post_media")
}

model File {
  id                   String     @id @default(uuid())
  mimeType             String?    @map("mime_type") @db.VarChar(50)
  filename             String     @db.VarChar(255)
  createdAt            DateTime   @default(now()) @map("created_at")
  lowQualityPostMedia  PostMedia? @relation("PostMediaLowQuality")
  highQualityPostMedia PostMedia? @relation("PostMediaHighQuality")

  @@map("file")
}

model Comment {
  id            String        @id @default(cuid())
  postId        String        @map("post_id")
  authorId      String        @map("author_id")
  parentId      String?       @map("parent_id")
  content       String
  likesCount    Int           @default(0) @map("likes_count")
  repliesCount  Int           @default(0) @map("replies_count")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("CommentReplies")
  commentLikes  CommentLike[]

  @@index([postId, parentId, createdAt])
  @@index([parentId, createdAt])
  @@index([deletedAt])
  @@map("comment")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, authorId])
  @@map("post_like")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, authorId])
  @@map("comment_like")
}

model Bookmark {
  id              String                   @id @default(cuid())
  postId          String                   @map("post_id")
  ownerId         String                   @map("owner_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  post            Post                     @relation(fields: [postId], references: [id], onDelete: Cascade)
  collectionItems BookmarkCollectionItem[]

  @@unique([postId, ownerId])
  @@index([ownerId, createdAt])
  @@map("bookmark")
}

model BookmarkCollection {
  id          String                   @id @default(cuid())
  ownerId     String                   @map("owner_id")
  name        String                   @db.VarChar(60)
  description String?                  @db.VarChar(280)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  items       BookmarkCollectionItem[]

  @@unique([ownerId, name])
  @@index([ownerId, createdAt])
  @@map("bookmark_collection")
}

model BookmarkCollectionItem {
  id           String             @id @default(cuid())
  collectionId String             @map("collection_id")
  bookmarkId   String             @map("bookmark_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  collection   BookmarkCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bookmark     Bookmark           @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@unique([collectionId, bookmarkId])
  @@index([collectionId, createdAt])
  @@index([bookmarkId])
  @@map("bookmark_collection_item")
}
