generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              String             @id @default(uuid())
  email                           String             @unique
  username                        String             @unique
  password                        String
  fullName                        String?            @map("full_name")
  bio                             String?
  lowQualityProfilePictureFileId  String?            @map("low_quality_profile_picture_file_id")
  bestQualityProfilePictureFileId String?            @map("best_quality_profile_picture_file_id")
  lowQualityCoverPictureFileId    String?            @map("low_quality_cover_picture_file_id")
  bestQualityCoverPictureFileId   String?            @map("best_quality_cover_picture_file_id")
  postCount                       Int                @default(0) @map("post_count")
  followersCount                  Int                @default(0) @map("followers_count")
  followingCount                  Int                @default(0) @map("following_count")
  unseenNotificationsCount        Int                @default(0) @map("unseen_notifications_count")
  active                          Boolean            @default(true)
  createdAt                       DateTime           @default(now()) @map("created_at")
  updatedAt                       DateTime           @updatedAt @map("updated_at")
  userVerifications               UserVerification[]
  followers                       Follow[]           @relation("UserFollowers")
  following                       Follow[]           @relation("UserFollowing")
  blockedUsers                    Block[]            @relation("UserBlocks")
  blockedByUsers                  Block[]            @relation("UserBlockedBy")
  searchHistoryAsSearcher         SearchHistory[]    @relation("SearchHistorySearcher")
  searchHistoryAsSearchedUser     SearchHistory[]    @relation("SearchHistorySearchedUser")

  @@map("user")
}

model SearchHistory {
  id             String   @id @default(uuid())
  searcherId     String   @map("searcher_id")
  text           String?  @db.VarChar(255)
  searchedUserId String?  @map("searched_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  searcher       User     @relation("SearchHistorySearcher", fields: [searcherId], references: [id], onDelete: Cascade)
  searchedUser   User?    @relation("SearchHistorySearchedUser", fields: [searchedUserId], references: [id], onDelete: Cascade)

  @@index([searcherId, createdAt, id])
  @@index([searchedUserId])
  @@map("search_history")
}

model File {
  id        String   @id @default(uuid())
  mimeType  String?  @map("mime_type") @db.VarChar(50)
  filename  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("file")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@map("follow")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt])
  @@index([blockedId])
  @@map("block")
}

model UserVerification {
  id                            String    @id @default(uuid())
  email                         String?
  fullName                      String?   @map("full_name")
  password                      String?
  goal                          String?
  verifiedAt                    DateTime? @map("verified_at")
  goalAchievedAt                DateTime? @map("goal_achieved_at")
  disabledAt                    DateTime? @map("disabled_at")
  code                          String
  token                         String
  numberOfFailedAttempts        Int       @default(0) @map("number_of_failed_attempts")
  numberOfCodeTransfersViaEmail Int       @default(0) @map("number_of_code_transfers_via_email")
  userId                        String?   @map("user_id")
  ip                            String?
  agent                         String?
  createdAt                     DateTime  @default(now()) @map("created_at")
  user                          User?     @relation(fields: [userId], references: [id])

  @@map("user_verification")
}
