generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              String             @id @default(uuid())
  email                           String             @unique
  username                        String             @unique
  password                        String
  fullName                        String?            @map("full_name")
  bio                             String?
  lowQualityProfilePictureFileId  String?            @unique @map("low_quality_profile_picture_file_id")
  lowQualityProfilePictureFile    File?              @relation("UserLowQualityProfilePicture", fields: [lowQualityProfilePictureFileId], references: [id], onDelete: SetNull)
  bestQualityProfilePictureFileId String?            @unique @map("best_quality_profile_picture_file_id")
  bestQualityProfilePictureFile   File?              @relation("UserBestQualityProfilePicture", fields: [bestQualityProfilePictureFileId], references: [id], onDelete: SetNull)
  lowQualityCoverPictureFileId    String?            @unique @map("low_quality_cover_picture_file_id")
  lowQualityCoverPictureFile      File?              @relation("UserLowQualityCoverPicture", fields: [lowQualityCoverPictureFileId], references: [id], onDelete: SetNull)
  bestQualityCoverPictureFileId   String?            @unique @map("best_quality_cover_picture_file_id")
  bestQualityCoverPictureFile     File?              @relation("UserBestQualityCoverPicture", fields: [bestQualityCoverPictureFileId], references: [id], onDelete: SetNull)
  postCount                       Int                @default(0) @map("post_count")
  followersCount                  Int                @default(0) @map("followers_count")
  followingCount                  Int                @default(0) @map("following_count")
  unseenNotificationsCount        Int                @default(0) @map("unseen_notifications_count")
  active                          Boolean            @default(true)
  createdAt                       DateTime           @default(now()) @map("created_at")
  updatedAt                       DateTime           @updatedAt @map("updated_at")
  userVerifications               UserVerification[]
  followers                       Follow[]           @relation("UserFollowers")
  following                       Follow[]           @relation("UserFollowing")
  blockedUsers                    Block[]            @relation("UserBlocks")
  blockedByUsers                  Block[]            @relation("UserBlockedBy")
  ownedSearchHistory              SearchHistory[]    @relation("SearchHistoryOwner")
  searchHistoryAppearances        SearchHistory[]    @relation("SearchHistoryUser")

  @@map("user")
}

model SearchHistory {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  text      String?  @db.VarChar(255)
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  owner     User     @relation("SearchHistoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user      User?    @relation("SearchHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt, id])
  @@index([userId])
  @@map("search_history")
}

model File {
  id                            String   @id @default(uuid())
  mimeType                      String?  @map("mime_type") @db.VarChar(50)
  filename                      String   @db.VarChar(255)
  createdAt                     DateTime @default(now()) @map("created_at")
  lowQualityProfilePictureUser  User?    @relation("UserLowQualityProfilePicture")
  bestQualityProfilePictureUser User?    @relation("UserBestQualityProfilePicture")
  lowQualityCoverPictureUser    User?    @relation("UserLowQualityCoverPicture")
  bestQualityCoverPictureUser   User?    @relation("UserBestQualityCoverPicture")

  @@map("file")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@map("follow")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt])
  @@index([blockedId, createdAt])
  @@map("block")
}

model UserVerification {
  id                            String    @id @default(uuid())
  email                         String?
  fullName                      String?   @map("full_name")
  password                      String?
  goal                          String?
  verifiedAt                    DateTime? @map("verified_at")
  goalAchievedAt                DateTime? @map("goal_achieved_at")
  disabledAt                    DateTime? @map("disabled_at")
  code                          String
  token                         String
  numberOfFailedAttempts        Int       @default(0) @map("number_of_failed_attempts")
  numberOfCodeTransfersViaEmail Int       @default(0) @map("number_of_code_transfers_via_email")
  userId                        String?   @map("user_id")
  ip                            String?
  agent                         String?
  createdAt                     DateTime  @default(now()) @map("created_at")
  user                          User?     @relation(fields: [userId], references: [id])

  @@map("user_verification")
}
