NODE_ENV=development

# Connexions aux bases PostgreSQL des microservices
USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media_project_user?schema=public
CONTENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media_content?schema=public

# Optionnel : appels API via la gateway au lieu de la DB directe
# USE_API=true
GATEWAY_BASE_URL=http://localhost:8000
SESSION_SERVICE_BASE_URL=http://localhost:8006

# Quantité de fake data
SEED_USER_COUNT=10
SEED_POSTS_PER_USER=3
SEED_COMMENTS_PER_POST=2
SEED_LIKE_PROBABILITY=0.3

# Médias
# Si MEDIA_OUTPUT_DIR est défini, les images SVG seront écrites sur disque.
# Sinon elles sont encodées en data URI inline.
# MEDIA_OUTPUT_DIR=./generated-media
MEDIA_BASE_URL=http://localhost:8000/media
