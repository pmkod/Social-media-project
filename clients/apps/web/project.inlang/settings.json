{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "en",
	"locales": ["en", "fr"],
	"modules": [
		"https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4.4.0/dist/index.js",
		"https://cdn.jsdelivr.net/npm/@inlang/plugin-m-function-matcher@2.2.6/dist/index.js"
	],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./messages/common/{locale}.json",
			"./messages/exceptions/{locale}.json",
			"./messages/authentication/{locale}.json",
			"./messages/bookmarks/{locale}.json",
			"./messages/comments/{locale}.json",
			"./messages/discussions/{locale}.json",
			"./messages/home/{locale}.json",
			"./messages/legal/{locale}.json",
			"./messages/notifications/{locale}.json",
			"./messages/posts/{locale}.json",
			"./messages/profile/{locale}.json",
			"./messages/reports/{locale}.json",
			"./messages/search/{locale}.json",
			"./messages/settings/{locale}.json"
		]
	}
}
