		"@rolldown/plugin-babel": "^0.2.3",
		"@tanstack/devtools-vite": "^0.8.5",
		"@types/node": "^26.3.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"babel-plugin-react-compiler": "^1.0.0",
