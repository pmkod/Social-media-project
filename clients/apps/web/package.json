{
	"name": "frontend",
	"private": true,
	"type": "module",
	"imports": {
		"@/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "bun run i18n:compile && vitest run",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@remixicon/react": "^4.9.0",
		"@tailwindcss/vite": "^4.3.3",
